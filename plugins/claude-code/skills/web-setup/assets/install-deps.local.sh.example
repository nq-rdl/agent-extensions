#   if ! grep -qF 'HOME/.pixi/bin' "$CLAUDE_ENV_FILE" 2>/dev/null; then
#     # shellcheck disable=SC2016
#     echo 'export PATH="$HOME/.pixi/bin:$PATH"' >> "$CLAUDE_ENV_FILE"
#     log "Persisted ~/.pixi/bin on PATH via CLAUDE_ENV_FILE."
#   fi
# fi

# # Start the Docker daemon (devcontainer smoke tests / k3d / testcontainers need it).
# #
# # WHY THIS IS A CLAUDE-CODE-WEB CONCERN: the web runner ships the docker CLI and
# # the dockerd binary but NO running daemon — and no systemd to start one — unlike
# # a laptop where Docker Desktop / a systemd unit keeps dockerd up. So a cloud
# # session that needs containers must start dockerd ITSELF, here in the per-session
# # seam (the portable engine deliberately does not — not every repo wants Docker).
# # install-deps.sh exposes $SUDO precisely for starting daemons like this. It is
# # idempotent (a no-op when `docker info` already answers), so it is safe to run
# # locally too, where Docker Desktop is already up.
# ensure_docker() {
#   command -v dockerd >/dev/null 2>&1 || return 0   # Docker not provisioned here.
#   docker info >/dev/null 2>&1 && return 0           # Already up (resume / base image).
#   log "Starting Docker daemon (dockerd) for the session…"
#   # nohup + background so the daemon outlives this sourced subshell; $SUDO is
#   # empty when root, `sudo -n` under an unprivileged remoteUser (unquoted so it
#   # word-splits into argv).
#   # shellcheck disable=SC2086
#   nohup $SUDO dockerd >>"$LOG" 2>&1 &
#   local i
#   for i in $(seq 1 30); do
#     docker info >/dev/null 2>&1 && { log "Docker daemon ready."; return 0; }
#     sleep 1
#   done
#   log "WARNING: dockerd did not become ready within 30s (see ${LOG})."
#   return 1
# }
# # The seam only runs on the web (the hook gates on CLAUDE_CODE_REMOTE) and
# # ensure_docker is idempotent (a no-op when `docker info` already answers).
# ensure_docker || true
