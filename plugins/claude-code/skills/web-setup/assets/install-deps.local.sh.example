#!/usr/bin/env bash
#
# install-deps.local.sh — OPTIONAL per-project dev toolchain for install-deps.sh.
#
# This is the sanctioned seam for project-specific provisioning. If it exists at
# .claude/scripts/install-deps.local.sh, install-deps.sh (the SessionStart hook)
# sources it as its "dev toolchain" step on every Claude Code on the web session.
# Put anything specific to THIS repo here (language toolchains, the Docker daemon,
# git-hook wiring) so the portable engine stays generic.
#
# It is sourced (not executed), so it shares install-deps.sh's helpers and
# globals: log(), $LOG (verbose sink), $PROJECT_DIR, $SUDO, $CLAUDE_ENV_FILE.
# Keep every step non-fatal — the parent must always exit 0 — and route verbose
# output to "$LOG" so it does not pollute the model context.
#
# Rename to `install-deps.local.sh` (drop `.example`) and commit it to enable.
#
# Everything below is illustrative — delete what you do not need.

# # Persist pixi on PATH for later Bash tool commands.
