{
  "description": "Advisory nudge to run /claude-code:skill-audit when a SKILL.md is created or edited",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/skill-audit-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
