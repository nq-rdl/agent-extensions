{
  "description": "Advisory Stylepedia lookup reminder when the copyedit skill is invoked",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stylepedia-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(tech-writing:copyedit|tech-writing-copyedit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stylepedia-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
