#!/usr/bin/env bash
# Fake pi: records arguments, cwd and attached files; prints $PI_OUT; exits $PI_EXIT.
set -eu
# Real pi -p reads a non-TTY stdin until EOF, so the helpers must not pass a pipe.
if [ -p /dev/stdin ]; then echo "fake pi: stdin is a pipe; real pi would block" >&2; exit 97; fi
jq -n --args '$ARGS.positional' -- "$@" > "$FIXTURE/pi.args"
printf '%s\n' "$PWD" > "$FIXTURE/pi.cwd"
rm -f "$FIXTURE/pi.request" "$FIXTURE/pi.fulldiff"
prev=""
for a in "$@"; do
    case "$prev" in --append-system-prompt) cp "$a" "$FIXTURE/pi.system" ;; esac
    case "$a" in @*) cp "${a#@}" "$FIXTURE/pi.request" ;; esac
    prev=$a
done
# A truncated review request names the complete diff; it must exist during the run.
if [ -f "$FIXTURE/pi.request" ]; then
    full=$(sed -n 's/.*The complete diff is \(.*\):$/\1/p' "$FIXTURE/pi.request" | head -1)
    [ -z "$full" ] || cp "$full" "$FIXTURE/pi.fulldiff"
fi
# Sessions, as pi 1.0.2 behaves: --session-id creates (registered here on
# success), --session must already exist. PI_GLOBAL=1 emulates a session found
# only in another project, where pi asks to fork and exits 0 without stdin.
new_id="" open_id=""
prev=""
for a in "$@"; do
    case "$prev" in --session-id) new_id=$a ;; --session) open_id=$a ;; esac
    prev=$a
done
if [ -n "$open_id" ]; then
    if [ "${PI_GLOBAL:-0}" = 1 ]; then
        printf 'Session found in different project: /elsewhere\nFork this session into current directory? [y/N] '
        exit 0
    fi
    if ! grep -qxF -- "$open_id" "$FIXTURE/pi.sessions" 2>/dev/null; then
        echo "No session found matching '$open_id'" >&2
        exit 1
    fi
fi
[ -z "${PI_OUT:-}" ] || cat "$PI_OUT"
if [ -n "$new_id" ] && [ "${PI_EXIT:-0}" = 0 ]; then printf '%s\n' "$new_id" >> "$FIXTURE/pi.sessions"; fi
exit "${PI_EXIT:-0}"
