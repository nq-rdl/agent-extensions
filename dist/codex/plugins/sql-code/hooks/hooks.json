{
  "description": "Native Codex command hooks for sql-code; review and trust before execution.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/adapter.sh\" sql-code-preflight",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/adapter.sh\" sql-code-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
