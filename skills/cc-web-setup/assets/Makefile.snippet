# --- Claude Code on the web provisioning (added by claude-code:web-setup) -----
# OPTIONAL. Plugins do NOT need this — they install from .claude/settings.json at
# session start in the cloud. This target is only for baking HEAVY, non-plugin
# dependencies (language toolchains, container runtimes, large caches) into the
# environment snapshot ONCE, before Claude starts. Put those steps in
# scripts/cc-web-setup.local.sh; wire this by setting the web environment's setup
# script to `make cc-web-setup`. Skip it entirely if the repo has no heavy
# pre-snapshot deps.
.PHONY: cc-web-setup
cc-web-setup: ## (Optional) Bake heavy non-plugin deps into the Claude Code on the web snapshot
	@bash scripts/cc-web-setup.sh
