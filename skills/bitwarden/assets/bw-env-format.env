# Example of the Secure Note format that bwc/bwu (scripts/bw-env.sh) store
# and bwe loads. You do not write this by hand: bwc converts an ordinary
# .env file (NAME=value, quoted or not) into these lines.
#
# Every value is single-quoted and literal: no $VAR interpolation. A single
# quote inside a value is stored as '\''. bwe refuses to eval a note that
# contains anything other than comments, blank lines, and export lines.
# Placeholder values only.

export API_KEY='sk-your-api-key-here'
export API_SECRET='your-secret-here'
export DATABASE_URL='postgres://user:password@localhost:5432/mydb'
export GREETING='hello world'
export APP_ENV='development'
