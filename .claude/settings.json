{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/web-bootstrap.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/announce-capabilities.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rdl@rdl": true,
    "codex@openai-codex": true,
    "gopls-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "motherduck-skills@motherduck-skills": true,
    "astral@astral-sh": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "svelte@svelte": true,
    "go@rdl": true,
    "rust@rdl": true,
    "r@rdl": true,
    "shiny@rdl": true,
    "quarto@rdl": true,
    "obsidian@rdl": true,
    "writerside@rdl": true,
    "zod@rdl": true,
    "defuddle@rdl": true,
    "git@rdl": true,
    "github-actions@rdl": true,
    "jules@rdl": true,
    "terraform@rdl": true,
    "kubernetes@rdl": true,
    "argo-cd@rdl": true,
    "ansible@rdl": true,
    "arch-linux@rdl": true,
    "starrocks@rdl": true,
    "postgres@rdl": true,
    "mongodb@rdl": true,
    "sops@rdl": true,
    "bitwarden@rdl": true,
    "pixi@rdl": true,
    "lychee@rdl": true,
    "charm-tui@rdl": true,
    "claude-code@rdl": true,
    "playwright@rdl": true,
    "skill@rdl": true,
    "review@rdl": true,
    "planning@rdl": true,
    "debug@rdl": true,
    "docs@rdl": true,
    "research@rdl": true,
    "lucid@rdl": true,
    "hooks@rdl": true
  },
  "extraKnownMarketplaces": {
    "rdl": {
      "source": {
        "source": "github",
        "repo": "nq-rdl/agent-extensions"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    },
    "motherduck-skills": {
      "source": {
        "source": "github",
        "repo": "motherduckdb/agent-skills"
      },
      "autoUpdate": true
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      },
      "autoUpdate": true
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      },
      "autoUpdate": true
    },
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh"
}
