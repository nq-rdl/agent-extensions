{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/web-bootstrap.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/announce-capabilities.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill@rdl": true,
    "claude-code@rdl": true,
    "hooks@rdl": true,
    "git@rdl": true,
    "github-actions@rdl": true,
    "go@rdl": true,
    "review@rdl": true
  },
  "extraKnownMarketplaces": {
    "rdl": {
      "source": {
        "source": "github",
        "repo": "nq-rdl/agent-extensions"
      },
      "autoUpdate": true
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh"
}
